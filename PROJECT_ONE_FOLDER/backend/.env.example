# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB Table Names (use BillSplitter- prefix)
DYNAMODB_USERS_TABLE=BillSplitter-Users
DYNAMODB_RECEIPTS_TABLE=BillSplitter-Receipts
DYNAMODB_SPLIT_SESSIONS_TABLE=BillSplitter-SplitSessions
DYNAMODB_PAYMENT_REQUESTS_TABLE=BillSplitter-PaymentRequests
DYNAMODB_TRANSACTION_HISTORY_TABLE=BillSplitter-TransactionHistory

# Alibaba Cloud AI (Qwen Model)
ALIBABA_API_KEY=your_qwen_api_key_here
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus
ALIBABA_VISION_MODEL=qwen-vl-plus

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=development

# TNG eWallet API (if applicable)
TNG_API_KEY=your_tng_api_key_here
TNG_MERCHANT_ID=your_merchant_id_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Lambda Settings (for local testing)
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512