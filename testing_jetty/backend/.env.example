# ============================================
# AWS Configuration (Access Key Authentication)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1

# ============================================
# AWS Services
# ============================================
# Amazon Textract OCR toggle
TEXTRACT_ENABLED=true

# Amazon Bedrock model for OCR and primary NLP
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ============================================
# Alibaba Cloud Configuration (Access Key Auth)
# ============================================
ALICLOUD_ACCESS_KEY_ID=
ALICLOUD_ACCESS_KEY_SECRET=
ALICLOUD_REGION=ap-southeast-3

# ============================================
# Alibaba Cloud Services
# ============================================
# Object Storage Service (OSS)
ALICLOUD_OSS_BUCKET=
ALICLOUD_OSS_ENDPOINT=oss-ap-southeast-3.aliyuncs.com

# Relational Database Service (RDS) connection string
ALICLOUD_DB_CONNECTION_STRING=

# DashScope LLM API (fallback NLP)
ALICLOUD_DASHSCOPE_API_KEY=
ALICLOUD_DASHSCOPE_MODEL_ID=qwen-max

# Function Compute endpoint
ALICLOUD_FC_ENDPOINT=

# ============================================
# Shared Infrastructure
# ============================================
# Redis URL for session caching (e.g., AWS ElastiCache Redis)
REDIS_URL=

# ============================================
# Application Settings
# ============================================
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
